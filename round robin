 #include <stdio.h>
   int main() {
    int n, tq;
    printf("Enter number of processes: ");
    scanf("%d", &n);
    
   int at[100], bt[100], rt[100];
    int ct[100], wt[100], tat[100];
    int i;
    
   printf("Enter arrival time and burst time for each process:\n");
    for (i = 1; i <= n; i++) {
    printf("Process %d Arrival Time: ",i);
    scanf("%d", &at[i]);
    printf("Process %d Burst Time: ",i);
    scanf("%d", &bt[i]);
    rt[i] = bt[i];
    }
    
   printf("Enter time quantum: ");
    scanf("%d", &tq);
    
   int time = 0, done = 0;
    while (done < n) {
    int progress = 0;
    for (i = 1; i <= n; i++) {
    if (at[i] <= time && rt[i] > 0) {
    progress = 1;
    if (rt[i] > tq) {
    time += tq;
    rt[i]-= tq;
    } else {
    time += rt[i];
    ct[i] = time;
    rt[i] = 0;
    done++;
    }
    }
    }
    if (!progress) time++; // CPU idle
    }
   
   float total_tat = 0, total_wt = 0;
    printf("\nProcess\tAT\tBT\tCT\tTAT\tWT\n");
    for (i = 1; i <= n; i++) {
    tat[i] = ct[i]-at[i];
    wt[i] = tat[i]-bt[i];
    total_tat += tat[i];
    total_wt += wt[i];
    printf("P%d\t%d\t%d\t%d\t%d\t%d\n", i, at[i], bt[i],
    ct[i], tat[i], wt[i]);
    }
    
   printf("\nAverage Turnaround Time: %.2f", total_tat / n);
    printf("\nAverage Waiting Time: %.2f\n", total_wt / n);
    
   return 0;
 59   }
